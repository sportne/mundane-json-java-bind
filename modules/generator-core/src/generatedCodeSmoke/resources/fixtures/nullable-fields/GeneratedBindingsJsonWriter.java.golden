package io.github.mundanej.mjjb.generated;

import io.github.mundanej.mjjb.runtime.JsonWriteException;
import io.github.mundanej.mjjb.runtime.JsonWriter;
import java.util.Objects;

public final class GeneratedBindingsJsonWriter {
  private GeneratedBindingsJsonWriter() {}

  public static void write(JsonWriter writer, GeneratedBindings value) throws JsonWriteException {
    Objects.requireNonNull(writer, "writer");
    Objects.requireNonNull(value, "value");
    if (value.score().hasValue()) {
      requireFinite(value.score().requireValue(), "score");
    }
    writer.beginObject();
    if (!value.nickname().isAbsent()) {
      writer.name("nickname");
      if (value.nickname().isExplicitNull()) {
        writer.nullValue();
      } else {
        writer.value(value.nickname().requireValue());
      }
    }
    if (!value.status().isAbsent()) {
      writer.name("status");
      if (value.status().isExplicitNull()) {
        writer.nullValue();
      } else {
        writer.value(value.status().requireValue());
      }
    }
    if (!value.code().isAbsent()) {
      writer.name("code");
      if (value.code().isExplicitNull()) {
        writer.nullValue();
      } else {
        writer.value(value.code().requireValue());
      }
    }
    if (!value.score().isAbsent()) {
      writer.name("score");
      if (value.score().isExplicitNull()) {
        writer.nullValue();
      } else {
        writer.number(Double.toString(value.score().requireValue()));
      }
    }
    if (!value.tags().isAbsent()) {
      writer.name("tags");
      if (value.tags().isExplicitNull()) {
        writer.nullValue();
      } else {
        writer.beginArray();
        for (String item : value.tags().requireValue()) {
          writer.value(item);
        }
        writer.endArray();
      }
    }
    if (!value.flags().isAbsent()) {
      writer.name("flags");
      if (value.flags().isExplicitNull()) {
        writer.nullValue();
      } else {
        writer.beginArray();
        for (Boolean item : value.flags().requireValue()) {
          writer.value(item);
        }
        writer.endArray();
      }
    }
    writer.endObject();
  }

  private static void requireFinite(double value, String name) throws JsonWriteException {
    if (!Double.isFinite(value)) {
      throw new JsonWriteException("JSON number field '" + name + "' must be finite.");
    }
  }
}
