package io.github.mundanej.mjjb.generated;

import io.github.mundanej.mjjb.runtime.JsonPath;
import io.github.mundanej.mjjb.runtime.ValidationError;
import io.github.mundanej.mjjb.runtime.ValidationErrors;
import io.github.mundanej.mjjb.runtime.ValidationMode;
import io.github.mundanej.mjjb.runtime.ValidationResult;
import java.math.BigDecimal;
import java.util.Objects;

public final class GeneratedBindingsJsonValidator {
  private static final BigDecimal DECIMAL_1 = new BigDecimal("1.5");
  private static final BigDecimal DECIMAL_2 = new BigDecimal("2e0");

  private GeneratedBindingsJsonValidator() {}

  public static ValidationResult validate(GeneratedBindings value) {
    return validate(value, ValidationMode.ACCUMULATE);
  }

  public static ValidationResult validate(GeneratedBindings value, ValidationMode mode) {
    Objects.requireNonNull(mode, "mode");
    ValidationErrors errors = ValidationErrors.create(mode);
    if (value == null) {
      errors.add(ValidationError.of("MJJBV-001", "Expected generated object value.", JsonPath.ROOT));
      return errors.toResult();
    }
    if (value.status() == null) {
      if (!errors.add(ValidationError.of("MJJBV-002", "Required property 'status' must not be null.", JsonPath.ROOT.property("status")))) {
        return errors.toResult();
      }
    }
    if (value.status() != null) {
      if (!validateEnum(errors, value.status().equals("open") || value.status().equals("closed"), JsonPath.ROOT.property("status"))) {
        return errors.toResult();
      }
    }
    if (value.kind() == null) {
      if (!errors.add(ValidationError.of("MJJBV-002", "Required property 'kind' must not be null.", JsonPath.ROOT.property("kind")))) {
        return errors.toResult();
      }
    }
    if (value.kind() != null) {
      if (!validateConst(errors, value.kind().equals("record"), JsonPath.ROOT.property("kind"))) {
        return errors.toResult();
      }
    }
    if (value.priority() == null) {
      if (!errors.add(ValidationError.of("MJJBV-003", "Optional property container 'priority' must not be null.", JsonPath.ROOT.property("priority")))) {
        return errors.toResult();
      }
    }
    if (value.priority() != null && value.priority().isPresent()) {
      if (!validateEnum(errors, value.priority().orElseThrow() == 1L || value.priority().orElseThrow() == 2L, JsonPath.ROOT.property("priority"))) {
        return errors.toResult();
      }
    }
    if (value.score() == null) {
      if (!errors.add(ValidationError.of("MJJBV-003", "Optional property container 'score' must not be null.", JsonPath.ROOT.property("score")))) {
        return errors.toResult();
      }
    }
    if (value.score() != null && value.score().isPresent()) {
      if (!validateFinite(errors, value.score().orElseThrow(), JsonPath.ROOT.property("score"))) {
        return errors.toResult();
      }
    }
    if (value.score() != null && value.score().isPresent() && Double.isFinite(value.score().orElseThrow())) {
      if (!validateEnum(errors, BigDecimal.valueOf(value.score().orElseThrow()).compareTo(decimal("1.5")) == 0 || BigDecimal.valueOf(value.score().orElseThrow()).compareTo(decimal("2e0")) == 0, JsonPath.ROOT.property("score"))) {
        return errors.toResult();
      }
      if (!validateConst(errors, BigDecimal.valueOf(value.score().orElseThrow()).compareTo(decimal("1.5")) == 0, JsonPath.ROOT.property("score"))) {
        return errors.toResult();
      }
    }
    if (value.active() == null) {
      if (!errors.add(ValidationError.of("MJJBV-003", "Optional property container 'active' must not be null.", JsonPath.ROOT.property("active")))) {
        return errors.toResult();
      }
    }
    if (value.active() != null && value.active().isPresent()) {
      if (!validateConst(errors, value.active().orElseThrow() == true, JsonPath.ROOT.property("active"))) {
        return errors.toResult();
      }
    }
    if (value.voided() == null) {
      if (!errors.add(ValidationError.of("MJJBV-003", "Optional property container 'voided' must not be null.", JsonPath.ROOT.property("voided")))) {
        return errors.toResult();
      }
    }
    if (value.voided() != null && value.voided().isPresent()) {
      if (!validateConst(errors, false, JsonPath.ROOT.property("voided"))) {
        return errors.toResult();
      }
    }
    if (value.tags() == null) {
      if (!errors.add(ValidationError.of("MJJBV-002", "Required property 'tags' must not be null.", JsonPath.ROOT.property("tags")))) {
        return errors.toResult();
      }
    }
    if (value.tags() != null) {
      int index = 0;
      for (String item : value.tags()) {
          if (true) {
            if (!validateEnum(errors, item.equals("red") || item.equals("blue"), JsonPath.ROOT.property("tags").index(index))) {
              return errors.toResult();
            }
          }
        index++;
      }
    }
    if (value.flags() == null) {
      if (!errors.add(ValidationError.of("MJJBV-003", "Optional property container 'flags' must not be null.", JsonPath.ROOT.property("flags")))) {
        return errors.toResult();
      }
    }
    if (value.flags() != null && value.flags().isPresent()) {
      int index = 0;
      for (Boolean item : value.flags().orElseThrow()) {
          if (true) {
            if (!validateConst(errors, item == true, JsonPath.ROOT.property("flags").index(index))) {
              return errors.toResult();
            }
          }
        index++;
      }
    }
    return errors.toResult();
  }

  private static boolean validateFinite(ValidationErrors errors, double value, JsonPath path) {
    if (Double.isFinite(value)) {
      return true;
    }
    return errors.add(ValidationError.of("MJJBV-004", "Expected finite JSON number.", path));
  }

  private static boolean validateEnum(
      ValidationErrors errors, boolean matches, JsonPath path) {
    if (matches) {
      return true;
    }
    return errors.add(
        ValidationError.of("MJJBV-015", "Expected value to match enum.", path));
  }

  private static boolean validateConst(
      ValidationErrors errors, boolean matches, JsonPath path) {
    if (matches) {
      return true;
    }
    return errors.add(
        ValidationError.of("MJJBV-016", "Expected value to match const.", path));
  }

  private static BigDecimal decimal(String literal) {
    return switch (literal) {
      case "1.5" -> DECIMAL_1;
      case "2e0" -> DECIMAL_2;
      default -> throw new IllegalArgumentException("Unknown generated numeric literal.");
    };
  }
}
