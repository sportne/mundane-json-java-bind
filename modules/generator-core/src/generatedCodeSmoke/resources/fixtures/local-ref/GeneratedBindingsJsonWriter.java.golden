import java.util.Objects;

public final class GeneratedBindingsJsonWriter {
  private GeneratedBindingsJsonWriter() {}

  public static void write(JsonWriter writer, GeneratedBindings value) throws JsonWriteException {
    Objects.requireNonNull(writer, "writer");
    Objects.requireNonNull(value, "value");
    writer.beginObject();
    writer.name("id");
    writer.value(value.id());
    writer.name("profile");
    writeGeneratedBindingsProfile(writer, value.profile());
    writer.endObject();
  }

  private static void writeGeneratedBindingsProfile(JsonWriter writer, GeneratedBindings.GeneratedBindingsProfile value) throws JsonWriteException {
    writer.beginObject();
    writer.name("name");
    writer.value(value.name());
    writer.name("address");
    writeGeneratedBindingsProfileAddress(writer, value.address());
    writer.endObject();
  }

  private static void writeGeneratedBindingsProfileAddress(JsonWriter writer, GeneratedBindings.GeneratedBindingsProfileAddress value) throws JsonWriteException {
    writer.beginObject();
