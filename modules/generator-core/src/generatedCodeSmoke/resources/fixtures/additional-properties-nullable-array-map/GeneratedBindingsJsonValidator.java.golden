package io.github.mundanej.mjjb.generated;

import io.github.mundanej.mjjb.runtime.JsonField;
import io.github.mundanej.mjjb.runtime.JsonPath;
import io.github.mundanej.mjjb.runtime.ValidationError;
import io.github.mundanej.mjjb.runtime.ValidationErrors;
import io.github.mundanej.mjjb.runtime.ValidationMode;
import io.github.mundanej.mjjb.runtime.ValidationResult;
import java.math.BigDecimal;
import java.util.List;
import java.util.Map;
import java.util.Objects;

public final class GeneratedBindingsJsonValidator {
  private static final BigDecimal DECIMAL_1 = new BigDecimal("0");

  private GeneratedBindingsJsonValidator() {}

  public static ValidationResult validate(GeneratedBindings value) {
    return validate(value, ValidationMode.ACCUMULATE);
  }

  public static ValidationResult validate(GeneratedBindings value, ValidationMode mode) {
    Objects.requireNonNull(mode, "mode");
    ValidationErrors errors = ValidationErrors.create(mode);
    if (value == null) {
      errors.add(ValidationError.of("MJJBV-001", "Expected generated object value.", JsonPath.ROOT));
      return errors.toResult();
    }
    if (value.id() == null) {
      if (!errors.add(ValidationError.of("MJJBV-002", "Required property 'id' must not be null.", JsonPath.ROOT.property("id")))) {
        return errors.toResult();
      }
    }
    if (value.additionalProperties() == null) {
      if (!errors.add(ValidationError.of("MJJBV-002", "additionalProperties map must not be null.", JsonPath.ROOT))) {
        return errors.toResult();
      }
    }
    if (value.additionalProperties() != null) {
      for (Map.Entry<String, JsonField<List<Double>>> entry : value.additionalProperties().entrySet()) {
        if (entry.getValue() == null) {
          if (!errors.add(ValidationError.of("MJJBV-002", "additionalProperties value must not be null.", JsonPath.ROOT.property(entry.getKey())))) {
            return errors.toResult();
          }
        }
        if (entry.getValue() != null && entry.getValue().isAbsent()) {
          if (!errors.add(ValidationError.of("MJJBV-017", "additionalProperties nullable value must be present or explicit null.", JsonPath.ROOT.property(entry.getKey())))) {
            return errors.toResult();
          }
        }
        if (entry.getValue() != null && entry.getValue().hasValue()) {
          if (!validateMinItems(errors, entry.getValue().requireValue().size(), 1L, JsonPath.ROOT.property(entry.getKey()))) {
            return errors.toResult();
          }
          int index = 0;
          for (Double item : entry.getValue().requireValue()) {
            if (!validateFinite(errors, item, JsonPath.ROOT.property(entry.getKey()).index(index))) {
              return errors.toResult();
            }
            if (Double.isFinite(item)) {
              if (!validateMinimum(errors, BigDecimal.valueOf(item), "0", JsonPath.ROOT.property(entry.getKey()).index(index))) {
                return errors.toResult();
              }
            }
            index++;
          }
        }
      }
    }
    return errors.toResult();
  }

  private static boolean validateFinite(ValidationErrors errors, double value, JsonPath path) {
    if (Double.isFinite(value)) {
      return true;
    }
    return errors.add(ValidationError.of("MJJBV-004", "Expected finite JSON number.", path));
  }

  private static boolean validateMinItems(ValidationErrors errors, int size, long minItems, JsonPath path) {
    if (size >= minItems) {
      return true;
    }
    return errors.add(ValidationError.of("MJJBV-005", "Expected at least " + minItems + " array items.", path));
  }

  private static boolean validateMinimum(
      ValidationErrors errors, BigDecimal value, String minimum, JsonPath path) {
    if (value.compareTo(decimal(minimum)) >= 0) {
      return true;
    }
    return errors.add(
        ValidationError.of(
            "MJJBV-011", "Expected number to be at least " + minimum + ".", path));
  }

  private static BigDecimal decimal(String literal) {
    return switch (literal) {
      case "0" -> DECIMAL_1;
      default -> throw new IllegalArgumentException("Unknown generated numeric literal.");
    };
  }
}
