package io.github.mundanej.mjjb.generated;

import io.github.mundanej.mjjb.runtime.JsonWriteException;
import io.github.mundanej.mjjb.runtime.JsonWriter;
import java.util.Objects;

public final class GeneratedBindingsJsonWriter {
  private GeneratedBindingsJsonWriter() {}

  public static void write(JsonWriter writer, GeneratedBindings value) throws JsonWriteException {
    Objects.requireNonNull(writer, "writer");
    Objects.requireNonNull(value, "value");
    writer.beginObject();
    writer.name("profile");
    writeGeneratedBindingsProfile(writer, value.profile());
    if (value.settings().isPresent()) {
      writer.name("settings");
      writeGeneratedBindingsSettings(writer, value.settings().orElseThrow());
    }
    writer.name("label");
    writer.value(value.label());
    writer.endObject();
  }

  private static void writeGeneratedBindingsProfile(JsonWriter writer, GeneratedBindings.GeneratedBindingsProfile value) throws JsonWriteException {
    writer.beginObject();
    writer.name("name");
    writer.value(value.name());
    writer.name("address");
    writeGeneratedBindingsProfileAddress(writer, value.address());
    writer.endObject();
  }

  private static void writeGeneratedBindingsProfileAddress(JsonWriter writer, GeneratedBindings.GeneratedBindingsProfileAddress value) throws JsonWriteException {
    writer.beginObject();
    writer.name("city");
    writer.value(value.city());
    if (value.postalCode().isPresent()) {
      writer.name("postalCode");
      writer.value(value.postalCode().orElseThrow());
    }
    writer.endObject();
  }

  private static void writeGeneratedBindingsSettings(JsonWriter writer, GeneratedBindings.GeneratedBindingsSettings value) throws JsonWriteException {
    writer.beginObject();
    if (value.enabled().isPresent()) {
      writer.name("enabled");
      writer.value(value.enabled().orElseThrow());
    }
    writer.endObject();
  }
}
