package io.github.mundanej.mjjb.generated;

import io.github.mundanej.mjjb.runtime.JsonPath;
import io.github.mundanej.mjjb.runtime.ValidationError;
import io.github.mundanej.mjjb.runtime.ValidationErrors;
import io.github.mundanej.mjjb.runtime.ValidationMode;
import io.github.mundanej.mjjb.runtime.ValidationResult;
import java.util.Objects;
import java.util.regex.Pattern;

public final class GeneratedBindingsJsonValidator {
  private static final Pattern PATTERN_1 = Pattern.compile("^[0-9]{5}$");

  private GeneratedBindingsJsonValidator() {}

  public static ValidationResult validate(GeneratedBindings value) {
    return validate(value, ValidationMode.ACCUMULATE);
  }

  public static ValidationResult validate(GeneratedBindings value, ValidationMode mode) {
    Objects.requireNonNull(mode, "mode");
    ValidationErrors errors = ValidationErrors.create(mode);
    if (value == null) {
      errors.add(ValidationError.of("MJJBV-001", "Expected generated object value.", JsonPath.ROOT));
      return errors.toResult();
    }
    if (value.profile() == null) {
      if (!errors.add(ValidationError.of("MJJBV-002", "Required property 'profile' must not be null.", JsonPath.ROOT.property("profile")))) {
        return errors.toResult();
      }
    }
    if (value.profile() != null) {
      validateGeneratedBindingsProfile(value.profile(), errors, JsonPath.ROOT.property("profile"), mode);
      if (mode == ValidationMode.FAIL_FAST && !errors.errors().isEmpty()) {
        return errors.toResult();
      }
    }
    if (value.settings() == null) {
      if (!errors.add(ValidationError.of("MJJBV-003", "Optional property container 'settings' must not be null.", JsonPath.ROOT.property("settings")))) {
        return errors.toResult();
      }
    }
    if (value.settings() != null && value.settings().isPresent()) {
      validateGeneratedBindingsSettings(value.settings().orElseThrow(), errors, JsonPath.ROOT.property("settings"), mode);
      if (mode == ValidationMode.FAIL_FAST && !errors.errors().isEmpty()) {
        return errors.toResult();
      }
    }
    if (value.label() == null) {
      if (!errors.add(ValidationError.of("MJJBV-002", "Required property 'label' must not be null.", JsonPath.ROOT.property("label")))) {
        return errors.toResult();
      }
    }
    if (value.label() != null) {
      if (!validateMinLength(errors, value.label(), 2L, JsonPath.ROOT.property("label"))) {
        return errors.toResult();
      }
    }
    return errors.toResult();
  }

  private static ValidationResult validateGeneratedBindingsProfile(GeneratedBindings.GeneratedBindingsProfile value, ValidationErrors errors, JsonPath basePath, ValidationMode mode) {
    if (value.name() == null) {
      if (!errors.add(ValidationError.of("MJJBV-002", "Required property 'name' must not be null.", basePath.property("name")))) {
        return errors.toResult();
      }
    }
    if (value.name() != null) {
      if (!validateMinLength(errors, value.name(), 2L, basePath.property("name"))) {
        return errors.toResult();
      }
    }
    if (value.address() == null) {
      if (!errors.add(ValidationError.of("MJJBV-002", "Required property 'address' must not be null.", basePath.property("address")))) {
        return errors.toResult();
      }
    }
    if (value.address() != null) {
      validateGeneratedBindingsProfileAddress(value.address(), errors, basePath.property("address"), mode);
      if (mode == ValidationMode.FAIL_FAST && !errors.errors().isEmpty()) {
        return errors.toResult();
      }
    }
    return errors.toResult();
  }

  private static ValidationResult validateGeneratedBindingsProfileAddress(GeneratedBindings.GeneratedBindingsProfileAddress value, ValidationErrors errors, JsonPath basePath, ValidationMode mode) {
    if (value.city() == null) {
      if (!errors.add(ValidationError.of("MJJBV-002", "Required property 'city' must not be null.", basePath.property("city")))) {
        return errors.toResult();
      }
    }
    if (value.postalCode() == null) {
      if (!errors.add(ValidationError.of("MJJBV-003", "Optional property container 'postalCode' must not be null.", basePath.property("postalCode")))) {
        return errors.toResult();
      }
    }
    if (value.postalCode() != null && value.postalCode().isPresent()) {
      if (!validatePattern(errors, value.postalCode().orElseThrow(), "^[0-9]{5}$", basePath.property("postalCode"))) {
        return errors.toResult();
      }
    }
    return errors.toResult();
  }

  private static ValidationResult validateGeneratedBindingsSettings(GeneratedBindings.GeneratedBindingsSettings value, ValidationErrors errors, JsonPath basePath, ValidationMode mode) {
    if (value.enabled() == null) {
      if (!errors.add(ValidationError.of("MJJBV-003", "Optional property container 'enabled' must not be null.", basePath.property("enabled")))) {
        return errors.toResult();
      }
    }
    return errors.toResult();
  }

  private static boolean validateMinLength(
      ValidationErrors errors, String value, long minLength, JsonPath path) {
    if (value.codePointCount(0, value.length()) >= minLength) {
      return true;
    }
    return errors.add(
        ValidationError.of(
            "MJJBV-007",
            "Expected at least " + minLength + " string code points.",
            path));
  }

  private static boolean validatePattern(
      ValidationErrors errors, String value, String pattern, JsonPath path) {
    if (compiledPattern(pattern).matcher(value).find()) {
      return true;
    }
    return errors.add(
        ValidationError.of("MJJBV-009", "Expected string to match pattern.", path));
  }

  private static Pattern compiledPattern(String pattern) {
    return switch (pattern) {
      case "^[0-9]{5}$" -> PATTERN_1;
      default -> throw new IllegalArgumentException("Unknown generated pattern.");
    };
  }
}
