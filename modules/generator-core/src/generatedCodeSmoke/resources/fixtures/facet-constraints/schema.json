{
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z]+$"
    },
    "label": {
      "type": "string",
      "maxLength": 4
    },
    "eventDate": {
      "type": "string",
      "format": "date"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "identifier": {
      "type": "string",
      "format": "uuid"
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "ratio": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "names": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "pattern": "^[a-z]+$"
      }
    },
    "scores": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      }
    }
  },
  "required": ["code", "count", "names"],
  "additionalProperties": false
}
