{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "details": {
      "type": "string"
    }
  },
  "required": [
    "id"
  ],
  "minProperties": 2,
  "maxProperties": 4,
  "propertyNames": {
    "type": "string",
    "minLength": 2,
    "maxLength": 7,
    "pattern": "^[a-z][a-z-]*$"
  },
  "dependentRequired": {
    "mode": [
      "details"
    ]
  },
  "patternProperties": {
    "^x-": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
