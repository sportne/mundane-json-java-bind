    reader.endObject();
    if (!stepCountSeen) {
      throw missingRequired("stepCount", propertyPath("stepCount"), reader.location());
    }
    if (!ratioSeen) {
      throw missingRequired("ratio", propertyPath("ratio"), reader.location());
    }
    if (!stepsSeen) {
      throw missingRequired("steps", propertyPath("steps"), reader.location());
    }
    if (!labelsSeen) {
