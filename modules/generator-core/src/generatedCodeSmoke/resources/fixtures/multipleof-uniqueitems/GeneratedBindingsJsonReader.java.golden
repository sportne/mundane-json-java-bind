    double ratio = 0.0D;
    boolean ratioSeen = false;
    List<Long> steps = null;
    boolean stepsSeen = false;
    List<String> labels = null;
    boolean labelsSeen = false;
    List<Double> scores = null;
    boolean scoresSeen = false;
    while (reader.hasNext()) {
      String name = reader.nextName();
      switch (name) {
        case "stepCount" -> {
          if (stepCountSeen) {
            throw duplicateProperty("stepCount", reader.location());
          }
          stepCount = readInteger(reader, propertyPath("stepCount"));
          stepCountSeen = true;
        }
        case "ratio" -> {
          if (ratioSeen) {
            throw duplicateProperty("ratio", reader.location());
          }
          ratio = readNumber(reader, propertyPath("ratio"));
          ratioSeen = true;
        }
        case "steps" -> {
          if (stepsSeen) {
            throw duplicateProperty("steps", reader.location());
          }
          steps = readIntegerArray(reader, propertyPath("steps"));
          stepsSeen = true;
        }
        case "labels" -> {
          if (labelsSeen) {
            throw duplicateProperty("labels", reader.location());
          }
          labels = readStringArray(reader, propertyPath("labels"));
          labelsSeen = true;
        }
        case "scores" -> {
          if (scoresSeen) {
            throw duplicateProperty("scores", reader.location());
          }
          scores = readNumberArray(reader, propertyPath("scores"));
          scoresSeen = true;
        }
        default ->
            throw error("MJJBR-004", "Unknown JSON property '" + name + "'.", propertyPath(name), reader.location());
      }
