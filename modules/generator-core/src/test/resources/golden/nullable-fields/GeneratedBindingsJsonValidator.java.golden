package io.github.mundanej.mjjb.generated;

import io.github.mundanej.mjjb.runtime.JsonPath;
import io.github.mundanej.mjjb.runtime.ValidationError;
import io.github.mundanej.mjjb.runtime.ValidationErrors;
import io.github.mundanej.mjjb.runtime.ValidationMode;
import io.github.mundanej.mjjb.runtime.ValidationResult;
import java.math.BigDecimal;
import java.util.Objects;

public final class GeneratedBindingsJsonValidator {
  private static final BigDecimal DECIMAL_1 = new BigDecimal("10");

  private GeneratedBindingsJsonValidator() {}

  public static ValidationResult validate(GeneratedBindings value) {
    return validate(value, ValidationMode.ACCUMULATE);
  }

  public static ValidationResult validate(GeneratedBindings value, ValidationMode mode) {
    Objects.requireNonNull(mode, "mode");
    ValidationErrors errors = ValidationErrors.create(mode);
    if (value == null) {
      errors.add(ValidationError.of("MJJBV-001", "Expected generated object value.", JsonPath.ROOT));
      return errors.toResult();
    }
    if (value.nickname() == null) {
      if (!errors.add(ValidationError.of("MJJBV-002", "Required nullable property 'nickname' field state must not be null.", JsonPath.ROOT.property("nickname")))) {
        return errors.toResult();
      }
    }
    if (value.nickname() != null && value.nickname().isAbsent()) {
      if (!errors.add(ValidationError.of("MJJBV-017", "Required nullable property 'nickname' must be present.", JsonPath.ROOT.property("nickname")))) {
        return errors.toResult();
      }
    }
    if (value.nickname() != null && value.nickname().hasValue()) {
      if (!validateMinLength(errors, value.nickname().requireValue(), 2L, JsonPath.ROOT.property("nickname"))) {
        return errors.toResult();
      }
    }
    if (value.nickname() != null && !value.nickname().isAbsent()) {
      if (!validateEnum(errors, (value.nickname().isExplicitNull() && true) || (value.nickname().hasValue() && (value.nickname().requireValue().equals("Ada"))), JsonPath.ROOT.property("nickname"))) {
        return errors.toResult();
      }
    }
    if (value.status() == null) {
      if (!errors.add(ValidationError.of("MJJBV-003", "Optional nullable property 'status' field state must not be null.", JsonPath.ROOT.property("status")))) {
        return errors.toResult();
      }
    }
    if (value.status() != null && !value.status().isAbsent()) {
      if (!validateConst(errors, value.status().isExplicitNull(), JsonPath.ROOT.property("status"))) {
        return errors.toResult();
      }
    }
    if (value.code() == null) {
      if (!errors.add(ValidationError.of("MJJBV-003", "Optional nullable property 'code' field state must not be null.", JsonPath.ROOT.property("code")))) {
        return errors.toResult();
      }
    }
    if (value.code() != null && !value.code().isAbsent()) {
      if (!validateConst(errors, value.code().hasValue() && value.code().requireValue().equals("OK"), JsonPath.ROOT.property("code"))) {
        return errors.toResult();
      }
    }
    if (value.score() == null) {
      if (!errors.add(ValidationError.of("MJJBV-003", "Optional nullable property 'score' field state must not be null.", JsonPath.ROOT.property("score")))) {
        return errors.toResult();
      }
    }
    if (value.score() != null && value.score().hasValue()) {
      if (!validateFinite(errors, value.score().requireValue(), JsonPath.ROOT.property("score"))) {
        return errors.toResult();
      }
    }
    if (value.score() != null && value.score().hasValue() && Double.isFinite(value.score().requireValue())) {
      if (!validateMaximum(errors, BigDecimal.valueOf(value.score().requireValue()), "10", JsonPath.ROOT.property("score"))) {
        return errors.toResult();
      }
    }
    if (value.tags() == null) {
      if (!errors.add(ValidationError.of("MJJBV-002", "Required nullable property 'tags' field state must not be null.", JsonPath.ROOT.property("tags")))) {
        return errors.toResult();
      }
    }
    if (value.tags() != null && value.tags().isAbsent()) {
      if (!errors.add(ValidationError.of("MJJBV-017", "Required nullable property 'tags' must be present.", JsonPath.ROOT.property("tags")))) {
        return errors.toResult();
      }
    }
    if (value.tags() != null && value.tags().hasValue()) {
      if (!validateMinItems(errors, value.tags().requireValue().size(), 1L, JsonPath.ROOT.property("tags"))) {
        return errors.toResult();
      }
      int index = 0;
      for (String item : value.tags().requireValue()) {
          if (true) {
            if (!validateMinLength(errors, item, 3L, JsonPath.ROOT.property("tags").index(index))) {
              return errors.toResult();
            }
          }
          if (true) {
            if (!validateEnum(errors, item.equals("red") || item.equals("blue"), JsonPath.ROOT.property("tags").index(index))) {
              return errors.toResult();
            }
          }
        index++;
      }
    }
    if (value.flags() == null) {
      if (!errors.add(ValidationError.of("MJJBV-003", "Optional nullable property 'flags' field state must not be null.", JsonPath.ROOT.property("flags")))) {
        return errors.toResult();
      }
    }
    if (value.flags() != null && value.flags().hasValue()) {
      int index = 0;
      for (Boolean item : value.flags().requireValue()) {
          if (true) {
            if (!validateConst(errors, item == true, JsonPath.ROOT.property("flags").index(index))) {
              return errors.toResult();
            }
          }
        index++;
      }
    }
    return errors.toResult();
  }

  private static boolean validateFinite(ValidationErrors errors, double value, JsonPath path) {
    if (Double.isFinite(value)) {
      return true;
    }
    return errors.add(ValidationError.of("MJJBV-004", "Expected finite JSON number.", path));
  }

  private static boolean validateMinItems(ValidationErrors errors, int size, long minItems, JsonPath path) {
    if (size >= minItems) {
      return true;
    }
    return errors.add(ValidationError.of("MJJBV-005", "Expected at least " + minItems + " array items.", path));
  }

  private static boolean validateMinLength(
      ValidationErrors errors, String value, long minLength, JsonPath path) {
    if (value.codePointCount(0, value.length()) >= minLength) {
      return true;
    }
    return errors.add(
        ValidationError.of(
            "MJJBV-007",
            "Expected at least " + minLength + " string code points.",
            path));
  }

  private static boolean validateMaximum(
      ValidationErrors errors, BigDecimal value, String maximum, JsonPath path) {
    if (value.compareTo(decimal(maximum)) <= 0) {
      return true;
    }
    return errors.add(
        ValidationError.of(
            "MJJBV-012", "Expected number to be at most " + maximum + ".", path));
  }

  private static boolean validateEnum(
      ValidationErrors errors, boolean matches, JsonPath path) {
    if (matches) {
      return true;
    }
    return errors.add(
        ValidationError.of("MJJBV-015", "Expected value to match enum.", path));
  }

  private static boolean validateConst(
      ValidationErrors errors, boolean matches, JsonPath path) {
    if (matches) {
      return true;
    }
    return errors.add(
        ValidationError.of("MJJBV-016", "Expected value to match const.", path));
  }

  private static BigDecimal decimal(String literal) {
    return switch (literal) {
      case "10" -> DECIMAL_1;
      default -> throw new IllegalArgumentException("Unknown generated numeric literal.");
    };
  }
}
