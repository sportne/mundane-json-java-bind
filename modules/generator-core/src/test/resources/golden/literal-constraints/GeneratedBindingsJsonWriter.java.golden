package io.github.mundanej.mjjb.generated;

import io.github.mundanej.mjjb.runtime.JsonWriteException;
import io.github.mundanej.mjjb.runtime.JsonWriter;
import java.util.Objects;

public final class GeneratedBindingsJsonWriter {
  private GeneratedBindingsJsonWriter() {}

  public static void write(JsonWriter writer, GeneratedBindings value) throws JsonWriteException {
    Objects.requireNonNull(writer, "writer");
    Objects.requireNonNull(value, "value");
    if (value.score().isPresent()) {
      requireFinite(value.score().orElseThrow(), "score");
    }
    writer.beginObject();
    writer.name("status");
    writer.value(value.status());
    writer.name("kind");
    writer.value(value.kind());
    if (value.priority().isPresent()) {
      writer.name("priority");
      writer.number(Long.toString(value.priority().orElseThrow()));
    }
    if (value.score().isPresent()) {
      writer.name("score");
      writer.number(Double.toString(value.score().orElseThrow()));
    }
    if (value.active().isPresent()) {
      writer.name("active");
      writer.value(value.active().orElseThrow());
    }
    if (value.voided().isPresent()) {
      writer.name("voided");
      writer.value(value.voided().orElseThrow());
    }
    writer.name("tags");
    writer.beginArray();
    for (String item : value.tags()) {
      writer.value(item);
    }
    writer.endArray();
    if (value.flags().isPresent()) {
      writer.name("flags");
      writer.beginArray();
      for (Boolean item : value.flags().orElseThrow()) {
        writer.value(item);
      }
      writer.endArray();
    }
    writer.endObject();
  }

  private static void requireFinite(double value, String name) throws JsonWriteException {
    if (!Double.isFinite(value)) {
      throw new JsonWriteException("JSON number field '" + name + "' must be finite.");
    }
  }
}
